{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/research-record.schema.json",
  "title": "AI Research OS Research Record",
  "type": "object",
  "required": [
    "research_id",
    "research_type",
    "title",
    "research_date",
    "time_horizon",
    "thesis",
    "scenarios",
    "invalidation_conditions",
    "status"
  ],
  "properties": {
    "research_id": {"type": "string"},
    "research_type": {
      "type": "string",
      "enum": ["article", "company", "sector", "macro", "ai_model", "tool", "portfolio"]
    },
    "title": {"type": "string"},
    "ticker": {"type": ["string", "null"]},
    "company_name": {"type": ["string", "null"]},
    "sector": {"type": ["string", "null"]},
    "research_date": {"type": "string", "format": "date"},
    "price_at_research": {"type": ["number", "null"]},
    "currency": {"type": ["string", "null"]},
    "time_horizon": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_type"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "source_type": {"type": "string"},
          "credibility": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
        }
      }
    },
    "market_consensus": {"type": ["string", "null"]},
    "thesis": {"type": "string"},
    "key_disagreement": {"type": ["string", "null"]},
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "probability", "description"],
        "properties": {
          "name": {"type": "string"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "description": {"type": "string"},
          "target_price": {"type": ["number", "null"]}
        }
      }
    },
    "expected_return": {"type": ["number", "null"]},
    "downside_risk": {"type": ["number", "null"]},
    "risk_reward_ratio": {"type": ["number", "null"]},
    "position": {
      "type": ["object", "null"],
      "properties": {
        "initial_pct": {"type": ["number", "null"]},
        "max_pct": {"type": ["number", "null"]},
        "add_conditions": {"type": "array", "items": {"type": "string"}},
        "reduce_conditions": {"type": "array", "items": {"type": "string"}},
        "exit_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "review_date": {"type": ["string", "null"], "format": "date"},
    "status": {
      "type": "string",
      "enum": ["draft", "active", "watching", "closed", "reviewed"]
    },
    "agent_scores": {"type": "array", "items": {"type": "object"}},
    "insight_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
