{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wangdaoer/ai-research-os/schemas/research-memory.schema.json",
  "title": "Research Memory Record",
  "type": "object",
  "required": ["memory_id", "entity_id", "entity_type", "created_at", "version", "events"],
  "properties": {
    "memory_id": {"type": "string"},
    "entity_id": {"type": "string"},
    "entity_type": {"enum": ["company", "industry", "theme", "macro", "model", "tool"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "current_thesis": {"type": "string"},
    "current_status": {"enum": ["watch", "researching", "active", "paused", "closed"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_date", "event_type", "summary", "source_record_id"],
        "properties": {
          "event_id": {"type": "string"},
          "event_date": {"type": "string", "format": "date"},
          "event_type": {"enum": ["research", "update", "decision", "earnings", "risk_event", "review", "rule_change"]},
          "summary": {"type": "string"},
          "source_record_id": {"type": "string"},
          "thesis_change": {"type": "string"},
          "confidence_before": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_after": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}